@inject IConfiguration Config

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">🦆 Duck Emporium</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column h-100">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ducks">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> All ducks
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="orders">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> My orders
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="assistant">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ask the Duck
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="employee,admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="staff">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Fulfilment
                </NavLink>
            </div>
        </AuthorizeView>

        @* Facilitator tooling — pushed to the bottom and set apart from the store nav above. *@
        <div class="nav-item px-3 mt-auto pt-2 border-top border-secondary">
            <div class="px-3 small text-uppercase text-secondary" style="letter-spacing:.05em;">Range tooling</div>
            <a class="nav-link" href="@Config["ExternalLinks:RangeControl"]" target="_blank" rel="noopener">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Range Control ↗
            </a>
        </div>
    </nav>
</div>

