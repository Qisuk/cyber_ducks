@page "/register"

<PageTitle>Create an account · Rubber Duck Emporium</PageTitle>

<div class="auth-card card mx-auto mt-4" style="max-width: 24rem">
    <div class="card-body">
        <h1 class="h4 card-title mb-3">Create an account</h1>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger py-2" role="alert">@Error</div>
        }

        <form method="post" action="/account/register">
            <div class="mb-3">
                <label class="form-label" for="displayName">Name</label>
                <input class="form-control" id="displayName" name="displayName" type="text" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input class="form-control" id="email" name="email" type="email" value="@Email" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <input class="form-control" id="password" name="password" type="password" required />
            </div>
            <button class="btn btn-warning w-100" type="submit">Create account</button>
        </form>

        <p class="small text-body-secondary mt-3 mb-0">
            Already have an account? <a href="login">Sign in</a>.
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
}
