@page "/ducks/{Id:int}"
@using CyberDucks.Shared.Defences
@inject StoreApiClient Api
@inject NavigationManager Navigation
@inject IDefenceFlags Flags

@if (_duck is not null)
{
    <PageTitle>@_duck.Name · Rubber Duck Emporium</PageTitle>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="ducks">All ducks</a></li>
            <li class="breadcrumb-item active" aria-current="page">@_duck.Name</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-md-5 text-center duck-detail-picture">
            <DuckPicture Sku="@_duck.Sku" Name="@_duck.Name" Size="280" />
        </div>
        <div class="col-md-7">
            <h1>@_duck.Name</h1>
            <p class="mb-2"><Stars Rating="_duck.AverageRating" Count="_duck.Reviews.Count" /></p>
            <p class="fs-3 fw-semibold mb-2">@_duck.Price.ToString("C", Gbp)</p>
            <p><StockBadge Stock="_duck.Stock" /> <span class="text-body-secondary small ms-2">SKU @_duck.Sku</span></p>
            <p class="lead">@_duck.Description</p>
            @if (_duck.Stock > 0)
            {
                <form method="post" action="/basket/add" class="d-flex gap-2 align-items-end" style="max-width: 20rem">
                    <input type="hidden" name="productId" value="@_duck.Id" />
                    <div>
                        <label class="form-label small mb-0" for="qty">Quantity</label>
                        <input class="form-control" id="qty" name="quantity" type="number" value="1" min="1" style="width: 5rem" />
                    </div>
                    <button class="btn btn-warning" type="submit">Add to basket</button>
                </form>
            }
        </div>
    </div>

    <section class="mt-5" style="max-width: 48rem">
        <h2 class="h4">Reviews</h2>
        @if (_duck.Reviews.Count == 0)
        {
            <p class="text-body-secondary">No reviews yet.</p>
        }
        @foreach (var review in _duck.Reviews)
        {
            <article class="border-bottom py-3">
                <div class="d-flex justify-content-between">
                    <strong>@review.Author</strong>
                    <span class="text-body-secondary small">@review.CreatedAt.ToString("d MMM yyyy")</span>
                </div>
                <Stars Rating="review.Rating" />
                @* VULN-XSS-01: vulnerable renders the user-supplied body as raw HTML (stored XSS,
                   threat TH13/A12); secure HTML-encodes it (Razor's safe default). *@
                @if (Flags.IsSecure("VULN-XSS-01"))
                {
                    <p class="mb-0 mt-1">@review.Body</p>
                }
                else
                {
                    <p class="mb-0 mt-1">@((MarkupString)review.Body)</p>
                }
            </article>
        }

        <AuthorizeView>
            <Authorized>
                <form method="post" action="/ducks/@_duck.Id/review" class="mt-3" style="max-width: 32rem">
                    <AntiforgeryToken />
                    <h3 class="h6">Add a review</h3>
                    <div class="mb-2">
                        <label class="form-label" for="rating">Rating</label>
                        <select class="form-select form-select-sm" id="rating" name="rating">
                            <option value="5">★★★★★</option>
                            <option value="4">★★★★</option>
                            <option value="3">★★★</option>
                            <option value="2">★★</option>
                            <option value="1">★</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="body">Your review</label>
                        <textarea class="form-control" id="body" name="body" rows="2" required></textarea>
                    </div>
                    <button class="btn btn-sm btn-warning" type="submit">Post review</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <p class="small text-body-secondary mt-3"><a href="login">Sign in</a> to leave a review.</p>
            </NotAuthorized>
        </AuthorizeView>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductDetail? _duck;

    protected override async Task OnInitializedAsync()
    {
        _duck = await Api.GetProductAsync(Id);
        if (_duck is null)
        {
            Navigation.NotFound();
        }
    }
}
