@page "/assistant"
@attribute [Authorize]
@inject ChatHistory History
@inject CyberDucks.Shared.Defences.IDefenceFlags Flags
@using CyberDucks.Shared.Defences

<PageTitle>Ask the Duck · Rubber Duck Emporium</PageTitle>

<h1>Ask the Duck 🦆</h1>
<p class="text-body-secondary" style="max-width: 40rem">
    Our assistant can look up your orders and answer questions about them. It runs on a small local
    model, so each answer can take a minute or so.
</p>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-warning" style="max-width: 40rem">@Error</div>
}

<div class="chat" style="max-width: 40rem">
    @if (_turns.Count == 0)
    {
        <p class="text-body-secondary fst-italic">Try “What's the status of my latest order?”</p>
    }
    @foreach (var turn in _turns)
    {
        <div class="chat-turn @(turn.Role == "user" ? "chat-user" : "chat-assistant")">
            <div class="chat-who">@(turn.Role == "user" ? "You" : "Duck assistant")</div>
            @* VULN-LLM-05: secure renders model output as text (Blazor encodes it). Vulnerable trusts
               it as HTML, so markup the model was steered into writing runs in the customer's page. *@
            @if (turn.Role == "assistant" && !_encodeReplies)
            {
                <div class="chat-text">@((MarkupString)turn.Content)</div>
            }
            else
            {
                <div class="chat-text">@turn.Content</div>
            }
            @if (turn.ToolsUsed.Count > 0)
            {
                <div class="chat-tools">looked up: @string.Join(", ", turn.ToolsUsed)</div>
            }
            @* VULN-LLM-06 (secure): the agent can only ask. The customer confirms here, with a normal
               store action outside the conversation. *@
            @foreach (var action in turn.PendingActions.Where(a => a.Kind == "cancel_order"))
            {
                <form method="post" action="/orders/@action.OrderId/cancel" class="mt-2">
                    <AntiforgeryToken />
                    <button class="btn btn-sm btn-outline-danger" type="submit">Confirm: cancel order #@action.OrderId</button>
                </form>
            }
        </div>
    }
</div>

<form method="post" action="/assistant/send" style="max-width: 40rem" class="mt-3"
      onsubmit="const b=this.querySelector('button');b.disabled=true;b.textContent='Thinking… (this can take a minute)';">
    <AntiforgeryToken />
    <label class="form-label visually-hidden" for="message">Your message</label>
    <textarea class="form-control mb-2" id="message" name="message" rows="2" maxlength="1000" required
              placeholder="Ask about your orders…"></textarea>
    <button class="btn btn-warning" type="submit">Send</button>
</form>

@if (_turns.Count > 0)
{
    <form method="post" action="/assistant/clear" class="mt-2">
        <AntiforgeryToken />
        <button class="btn btn-link btn-sm px-0" type="submit">Start a new conversation</button>
    </form>
}

@code {
    private IReadOnlyList<ChatTurn> _turns = [];
    private bool _encodeReplies;

    [SupplyParameterFromQuery] public string? Error { get; set; }

    protected override void OnInitialized()
    {
        _turns = History.Get();
        _encodeReplies = Flags.IsSecure("VULN-LLM-05", "Assistant page");
    }
}
