@page "/account"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject StoreApiClient Api

<PageTitle>My account · Rubber Duck Emporium</PageTitle>

<h1>My account</h1>

@if (_me is null)
{
    <p class="text-body-secondary">@(_error ?? "Loading…")</p>
}
else
{
    <dl class="row" style="max-width: 32rem">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@_me.DisplayName</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@_me.Email</dd>
        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9"><span class="badge text-bg-secondary">@_me.Role</span></dd>
    </dl>
    <a class="btn btn-warning" href="orders">View my orders</a>

    <hr class="my-4" style="max-width: 32rem" />

    <form method="post" action="/account/profile" style="max-width: 32rem">
        <h2 class="h5">Edit profile</h2>
        <div class="mb-2">
            <label class="form-label" for="displayName">Display name</label>
            <input class="form-control" id="displayName" name="displayName" value="@_me.DisplayName" required />
        </div>
        @* The form only lets you change your name. The API is what decides whether anything else
           in the request is honoured (VULN-MASS-01) — the classic test is adding a "role" field by hand. *@
        <button class="btn btn-warning" type="submit">Save</button>
    </form>
}

@code {
    private UserInfo? _me;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Calls store-api /api/auth/me with the forwarded JWT (flow F4). Proves the token round-trips.
        try
        {
            _me = await Api.GetMeAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not load your account: {ex.Message}";
        }
    }
}
