@page "/wargame"
@rendermode InteractiveServer
@attribute [Authorize]
@using RangeControl.Wargame
@inject WargameService Games
@inject ScenarioCatalog Catalog
@inject NavigationManager Nav

<PageTitle>Wargame · Range Control</PageTitle>

<h1 class="h3 mb-0">Wargame</h1>
<p class="text-secondary small">
    Hybrid exercise (ADR-0008): investigate the real range telemetry, decide at tabletop level, and
    log every decision. Release injects and reveal the ground truth from the exercise console.
</p>

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h6 text-uppercase text-secondary">Exercises</h2>
        @if (_exercises is null)
        {
            <p class="text-secondary">Loading…</p>
        }
        else if (_exercises.Count == 0)
        {
            <p class="text-secondary small">No exercises yet. Create one from a scenario.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var ex in _exercises)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                       href="wargame/@ex.Id">
                        <div>
                            <div class="fw-semibold">@ex.Title</div>
                            <code class="small">@ex.ScenarioId</code>
                            <span class="small text-secondary ms-2">created @ex.CreatedAt.UtcDateTime.ToString("d MMM HH:mm 'UTC'")</span>
                        </div>
                        <span class="badge @StatusBadge(ex.Status)">@ex.Status</span>
                    </a>
                }
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card-dark">
            <h2 class="h6 text-uppercase text-secondary">New exercise</h2>
            @if (_scenarios.Count == 0)
            {
                <p class="text-secondary small mb-0">No scenarios found. Check that <code>wargame/scenarios</code> is mounted.</p>
            }
            else
            {
                <label class="form-label small" for="scenario">Scenario</label>
                <select id="scenario" class="form-select mb-2" @bind="_scenarioId">
                    @foreach (var s in _scenarios)
                    {
                        <option value="@s.Id">@s.Title (@s.DurationMinutes min)</option>
                    }
                </select>
                @if (_scenarios.FirstOrDefault(s => s.Id == _scenarioId) is { } chosen)
                {
                    <p class="small text-secondary">@chosen.Summary</p>
                }
                <label class="form-label small" for="title">Exercise name</label>
                <input id="title" class="form-control mb-2" @bind="_title" placeholder="e.g. Solo run 1" />
                <label class="form-label small" for="facilitator">Facilitator name</label>
                <input id="facilitator" class="form-control mb-3" @bind="_facilitator" />

                @* One-click self-running exercise: a team can run a scenario with no facilitator
                   releasing injects, outside an organised session (ADR-0008). *@
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="autorun" @bind="_autoRun" />
                    <label class="form-check-label small" for="autorun">
                        Auto-run — release injects automatically (no facilitator needed)
                    </label>
                </div>
                @if (_autoRun)
                {
                    <label class="form-label small" for="speed">Pace</label>
                    <select id="speed" class="form-select form-select-sm mb-3 w-auto" @bind="_speed">
                        @foreach (var s in ExerciseConsole.Speeds)
                        {
                            <option value="@ExerciseConsole.FormatSpeed(s)">@ExerciseConsole.FormatSpeed(s)× (@PaceHint(s))</option>
                        }
                    </select>
                }
                <button class="btn btn-warning" @onclick="Create"
                        disabled="@(string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_facilitator))">
                    @(_autoRun ? "Create & auto-run" : "Create exercise")
                </button>
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<Exercise>? _exercises;
    private IReadOnlyList<Scenario> _scenarios = [];
    private string _scenarioId = "";
    private string _title = "";
    private string _facilitator = "Facilitator";
    private bool _autoRun;
    private string _speed = "10";

    protected override async Task OnInitializedAsync()
    {
        _scenarios = Catalog.All();
        _scenarioId = _scenarios.FirstOrDefault()?.Id ?? "";
        _exercises = await Games.GetExercisesAsync();
    }

    private async Task Create()
    {
        var id = await Games.CreateExerciseAsync(_scenarioId, _title.Trim(), _facilitator.Trim());
        if (_autoRun)
        {
            // One click to a self-running exercise: set the pace, turn autoplay on, and start it —
            // the ExerciseClock then releases injects on schedule with no facilitator action.
            var speed = double.TryParse(_speed, System.Globalization.CultureInfo.InvariantCulture, out var s) ? s : 10;
            await Games.SetSpeedAsync(id, speed);
            await Games.SetAutoplayAsync(id, true);
            await Games.StartAsync(id);
            // No facilitator to set the map, so seed the ground truth from the scenario — otherwise the
            // after-action "detected vs truth" gap would be empty on a self-run.
            if (Catalog.Find(_scenarioId) is { } scenario)
            {
                await Games.ApplyGroundTruthAsync(id, scenario, "scenario");
            }
        }
        Nav.NavigateTo($"wargame/{id}");
    }

    // Rough wall-clock time to play a 90-minute scenario at the given speed.
    private static string PaceHint(double speed) => speed switch
    {
        1 => "real time",
        >= 60 => "demo",
        _ => $"~{Math.Max(1, (int)(90 / speed))} min",
    };

    internal static string StatusBadge(string status) => status switch
    {
        "running" => "text-bg-warning",
        "ended" => "text-bg-secondary",
        _ => "text-bg-info",
    };
}
