@page "/"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject FlagAdminService Admin
@inject DefenceDetailSource Details
@inject IConfiguration Config

<PageTitle>Range Control</PageTitle>

<details class="rc-intro mb-4" open>
    <summary class="h5 mb-0" style="cursor:pointer;">🦆 Range Control — facilitator console</summary>
    <p class="text-secondary mt-2 mb-3">
        The control plane for the Cyber Ducks range: a deliberately-vulnerable rubber-duck shop
        for practising attack and defence. From here you arm or disarm each weakness, run incident
        wargames, and watch detections land. Defenders attack the store from the LAN; you and the
        blue team work from the host.
    </p>
    <div class="row g-3">
        <div class="col-md-6 col-lg-4">
            <div class="border rounded p-2 h-100">
                <div class="fw-semibold">🛡️ Defences <span class="badge bg-secondary">this page</span></div>
                <div class="small text-secondary">Toggle each vulnerability vulnerable ⇄ secure (live, no restart).
                    Expand a row for how to attack it and how the fix works.</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="border rounded p-2 h-100">
                <div class="fw-semibold"><a href="wargame">🎯 Wargame</a></div>
                <div class="small text-secondary">Create and run incident exercises. Open an exercise to drive the
                    dual-layer map (detected vs ground truth), release injects, and log decisions.</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="border rounded p-2 h-100">
                <div class="fw-semibold"><a href="runbook">📖 Runbook</a></div>
                <div class="small text-secondary">How to run an exercise, log-in notes, and the defender's
                    Grafana guide — a worked example end to end.</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="border rounded p-2 h-100">
                <div class="fw-semibold"><a href="@Config["ExternalLinks:Grafana"]" target="_blank" rel="noopener">📊 SIEM (Grafana) ↗</a></div>
                <div class="small text-secondary">Logs, traces, metrics and alert rules — where defenders spot
                    and investigate attacks.</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="border rounded p-2 h-100">
                <div class="fw-semibold"><a href="@Config["ExternalLinks:Store"]" target="_blank" rel="noopener">🛒 Store ↗</a></div>
                <div class="small text-secondary">The target application itself — browse it as a customer to see
                    what the attacks act on.</div>
            </div>
        </div>
    </div>
</details>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Defence toggles</h1>
        <p class="text-secondary small mb-0">Flip a defence on or off. Changes reach the range within seconds.</p>
    </div>
    <div class="btn-group">
        <button class="btn btn-outline-danger" @onclick='() => ApplyPreset("All vulnerable")'>All vulnerable</button>
        <button class="btn btn-outline-success" @onclick='() => ApplyPreset("All secure")'>All secure</button>
    </div>
</div>

@if (_flags is null)
{
    <p class="text-secondary">Loading…</p>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            @foreach (var group in _flags.GroupBy(f => f.Kind))
            {
                <h2 class="h6 text-uppercase text-secondary mt-3">@KindLabel(group.Key)</h2>
                <div class="list-group mb-2">
                    @foreach (var flag in group)
                    {
                        var secure = flag.Mode == "secure";
                        var detail = _details.GetValueOrDefault(flag.VulnId);
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@flag.Title</div>
                                    <code class="small text-secondary">@flag.VulnId</code>
                                    @if (flag.RequiresRestart)
                                    {
                                        <span class="badge text-bg-warning ms-1">restart</span>
                                    }
                                </div>
                                <div class="form-check form-switch fs-5">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@secure" @onchange="() => ToggleFlag(flag)" />
                                    <span class="badge @(secure ? "text-bg-success" : "text-bg-danger") align-middle">
                                        @(secure ? "secure" : "vulnerable")
                                    </span>
                                </div>
                            </div>
                            @if (detail is not null)
                            {
                                <details class="mt-2">
                                    <summary class="small text-secondary">How to simulate & mitigate</summary>
                                    <div class="small mt-2">
                                        <div class="mb-2">
                                            <span class="badge text-bg-danger me-1">Attack</span>
                                            @detail.Simulate
                                        </div>
                                        <div>
                                            <span class="badge text-bg-success me-1">Mitigation</span>
                                            @detail.Mitigation
                                        </div>
                                    </div>
                                </details>
                            }
                        </div>
                    }
                </div>
            }

            <h2 class="h6 text-uppercase text-secondary mt-4">Database guards</h2>
            <p class="text-secondary small">A second layer of defence enforced in Postgres itself.</p>
            <div class="list-group">
                @foreach (var guard in _guards)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <code class="small">@guard.Guard</code>
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   checked="@guard.Enabled" @onchange="() => ToggleGuard(guard)" />
                            <span class="badge @(guard.Enabled ? "text-bg-success" : "text-bg-secondary") align-middle">
                                @(guard.Enabled ? "on" : "off")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <h2 class="h6 text-uppercase text-secondary mt-3">Recent changes</h2>
            @if (_changes.Count == 0)
            {
                <p class="text-secondary small">No changes yet.</p>
            }
            else
            {
                <ul class="list-unstyled small">
                    @foreach (var change in _changes)
                    {
                        <li class="mb-2">
                            <span class="text-secondary">@change.ChangedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                            <code>@change.VulnId</code>
                            @change.OldMode → <strong>@change.NewMode</strong>
                            <span class="text-secondary">(@change.ChangedBy)</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    private IReadOnlyList<DefenceFlag>? _flags;
    private IReadOnlyList<GuardState> _guards = [];
    private IReadOnlyList<FlagChange> _changes = [];
    private IReadOnlyDictionary<string, DefenceDetail> _details = new Dictionary<string, DefenceDetail>();

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _flags = await Admin.GetFlagsAsync();
        _guards = await Admin.GetGuardsAsync();
        _changes = await Admin.GetRecentChangesAsync();
        _details = Details.Load();
    }

    private async Task ToggleFlag(DefenceFlag flag)
    {
        await Admin.SetFlagAsync(flag.VulnId, flag.Mode == "secure" ? "vulnerable" : "secure", "facilitator");
        await RefreshAsync();
    }

    private async Task ToggleGuard(GuardState guard)
    {
        await Admin.SetGuardAsync(guard.Guard, !guard.Enabled);
        await RefreshAsync();
    }

    private async Task ApplyPreset(string name)
    {
        await Admin.ApplyPresetAsync(name, "facilitator");
        await RefreshAsync();
    }

    private static string KindLabel(string kind) => kind switch
    {
        "code" => "Code-path defences",
        "data" => "Data & schema defences",
        "infra" => "Infrastructure defences",
        _ => kind,
    };
}
