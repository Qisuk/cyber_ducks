@inherits LayoutComponentBase
@inject IConfiguration Config

<div class="rc-shell">
    <header class="rc-header d-flex justify-content-between align-items-center px-4 py-2">
        <div class="d-flex align-items-center">
            <a class="rc-brand me-4" href="">🦆 Range Control</a>
            <AuthorizeView>
                <nav class="rc-nav">
                    <NavLink href="" Match="NavLinkMatch.All">Defences</NavLink>
                    <NavLink href="wargame">Wargame</NavLink>
                    <NavLink href="flags">Flags</NavLink>
                    <NavLink href="detection">Detection</NavLink>
                    <NavLink href="runbook">Runbook</NavLink>
                    <a href="@Config["ExternalLinks:Grafana"]" target="_blank" rel="noopener">SIEM (Grafana) ↗</a>
                    <a href="@Config["ExternalLinks:Store"]" target="_blank" rel="noopener">Store ↗</a>
                </nav>
            </AuthorizeView>
        </div>
        <AuthorizeView>
            <Authorized>
                <form method="post" action="/account/logout" class="m-0">
                    <span class="small me-2 text-light-emphasis">facilitator</span>
                    <button class="btn btn-sm btn-outline-light" type="submit">Sign out</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </header>
    <main class="rc-main px-4 py-4">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
