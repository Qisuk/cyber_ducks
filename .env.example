# Copy to .env and adjust. .env is git-ignored.
# Every value here is a FAKE range credential. Never put real secrets in this file.

# --- Postgres ---
POSTGRES_DB=duckstore
POSTGRES_USER=duckadmin
POSTGRES_PASSWORD=QuackQuack123
POSTGRES_PORT=5432

# Service roles (01-roles.sh). No service connects as POSTGRES_USER.
STORE_OWNER_PASSWORD=StoreOwnerQuack1
STORE_APP_PASSWORD=StoreAppQuack2
RANGE_CONTROL_PASSWORD=RangeControlQuack3
FLAGS_READER_PASSWORD=FlagsReaderQuack4
BACKUP_READER_PASSWORD=BackupReaderQuack5
METRICS_READER_PASSWORD=MetricsReaderQuack6

# --- Telemetry ---
GRAFANA_PORT=3000

# --- Range control panel (Z9, facilitator only) ---
RANGE_CONTROL_PORT=8090
FACILITATOR_PASSWORD=facilitator-change-me

# --- Payments (fake webhook secret shared by store-api and payment-stub) ---
WEBHOOK_SECRET=dev-webhook-secret-change-me-0002

# --- Store ---
STORE_PORT=8080

# --- Auth (step 3c, all fake) ---
# JWT signing secret. In secure terms this should be long and random; it is a toggle target later.
JWT_SECRET=dev-insecure-jwt-signing-secret-change-me-0001
# Persona passwords. alice/bob are deliberately weak and guessable; staff/admin are stronger.
PERSONA_ALICE_PASSWORD=password1
PERSONA_BOB_PASSWORD=letmein
PERSONA_CAROL_PASSWORD=Carol.Duck.2026
PERSONA_DAVE_PASSWORD=Dave.Duck.2026
PERSONA_EVE_PASSWORD=Eve-Staff-7h3nk
PERSONA_MALLORY_PASSWORD=M4llory-Admin-9xQ
PERSONA_TRENT_PASSWORD=Tr3nt-Audit-5zP

# --- Backups ---
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP=24

# --- LLM (ADR-0010). Default is the local Ollama container. ---
# Llm__Provider=Ollama            # Ollama | Anthropic | OpenAICompatible
# Llm__Model=qwen3:4b
# Llm__Endpoint=
